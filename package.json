{
  "name": "kull",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @kull/api prisma:migrate",
    "db:generate": "pnpm --filter @kull/api prisma:generate",
    "db:studio": "pnpm --filter @kull/api prisma:studio"
  },
  "devDependencies": {
    "turbo": "^2.10.8"
  }
}
