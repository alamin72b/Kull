generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Activity {
  id           String   @id @default(uuid()) @db.Uuid // Must be String and @db.Uuid
  name         String   @db.VarChar(120) // Must be @db, not @DB
  activityDate DateTime @db.Date
  startAt      DateTime @db.Timestamptz(3)
  endAt        DateTime @db.Timestamptz(3)
  note         String?   @db.VarChar(1200) 
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  @@index([activityDate, startAt])
  @@map("activities")
}